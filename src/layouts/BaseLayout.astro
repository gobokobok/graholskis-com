---
import "../styles/global.css";
import "../styles/kit.css";
import "@fontsource-variable/manrope";
import "@fontsource-variable/inter";
import "@fontsource/fragment-mono/400.css";
import TopBar from "../components/TopBar.astro";
import Footer from "../components/Footer.astro";
import Tooltip from "../components/Tooltip.astro";
import ContactDialog from "../components/ContactDialog.astro";

interface Props {
  /** SEO title, appended with site name unless `bareTitle` is true */
  title: string;
  /** SEO description (≤ 160 chars) */
  description?: string;
  /** Override the default OG title behaviour */
  bareTitle?: boolean;
  /** Optional canonical path override (defaults to current URL) */
  canonical?: string;
  /** Keep the page out of search results (unlisted pages reached by link only) */
  noindex?: boolean;
  /** Page is rebuilt on the Pill & Glow kit: enables its body type and the dark theme */
  kit?: boolean;
  /** The bottom-right contact panel; off on pages with their own contact section */
  contactDialog?: boolean;
}

const {
  title,
  description = "I help organisations move from AI experiments to governed, scaled adoption.",
  bareTitle = false,
  canonical,
  noindex = false,
  kit = false,
  contactDialog = true,
} = Astro.props;

const siteName = "Aleksandrs Graholskis";
const fullTitle = bareTitle ? title : `${title} | ${siteName}`;
const canonicalURL = canonical
  ? new URL(canonical, Astro.site ?? Astro.url).href
  : new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en" class:list={[kit && "kit"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {/* Schema.org Person: establishes professional identity for search */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Aleksandrs Graholskis",
        jobTitle: "AI Enablement Lead",
        url: "https://graholskis.com",
        sameAs: [
          "https://www.linkedin.com/in/aleksandrs-graholskis/",
          "https://github.com/gobokobok",
        ],
        knowsAbout: [
          "Enterprise AI Architecture",
          "AI Governance",
          "Retrieval-Augmented Generation",
          "Agentic Workflows",
          "EU AI Act Compliance",
          "Shadow AI Remediation",
        ],
      })}
    />
    {/* Before first paint: a saved theme choice, and the class that lets reveal-on-scroll hide content */}
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch (e) {}
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only"
    >
      Skip to content
    </a>

    <TopBar />

    <main id="main">
      <slot />
    </main>

    <Footer />
    {contactDialog && <ContactDialog />}
    <Tooltip />
  </body>
</html>
