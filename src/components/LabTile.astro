---
import type { LabItem } from "../config";

interface Props {
  item: LabItem;
  i?: number;
}
const { item, i = 0 } = Astro.props;
---

<div class="pg-card pg-reveal pg-lab" style={`--i:${i}`}>
  {
    item.video !== undefined && (
      <div class="pg-inner pg-lab-video">
        {item.video ? (
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${item.video}`}
            title={`${item.name}: video`}
            loading="lazy"
            allow="encrypted-media; picture-in-picture"
            allowfullscreen
          />
        ) : (
          <span class="pg-label">Video slot</span>
        )}
      </div>
    )
  }
  <h3 class="pg-h3">{item.name}</h3>
  <p class="pg-small">{item.line}</p>
  <div class="pg-card-foot">
    {
      item.href ? (
        <a href={item.href} class="pg-link" rel="noopener" target="_blank">{item.cta ?? "Open the tool"} →</a>
      ) : (
        <span class="pg-pill pg-pill-dashed">Coming soon</span>
      )
    }
  </div>
</div>
