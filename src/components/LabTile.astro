---
import type { LabItem } from "../config";

interface Props {
  item: LabItem;
}
const { item } = Astro.props;
---

<div class="card lab">
  {
    item.video !== undefined && (
      <div class="lab-video">
        {item.video ? (
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${item.video}`}
            title={`${item.name}: video`}
            loading="lazy"
            allow="encrypted-media; picture-in-picture"
            allowfullscreen
          />
        ) : (
          <span class="meta">Video slot</span>
        )}
      </div>
    )
  }
  <h3 class="h-card">{item.name}</h3>
  <p>{item.line}</p>
  {
    item.href ? (
      <a href={item.href} class="link" rel="noopener" target="_blank">{item.cta ?? "Open the tool"} ↗</a>
    ) : (
      <span class="chip" style="justify-self:start;">Coming soon</span>
    )
  }
</div>
