---
// Footer in the same pills as the top bar: brand, footer menu, then copyright, profiles and the call link.
import { site, links, contactEmail, footerNav, bookHref, calendarUrl } from "../config";
import Brand from "./Brand.astro";

const year = new Date().getFullYear();
const bookAttrs = calendarUrl ? { target: "_blank", rel: "noopener" } : {};

// 16px glyphs, drawn in currentColor.
const profiles = [
  {
    label: "LinkedIn",
    href: links.linkedin,
    path: "M1 5.5h3V15H1zM2.5 1a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2zM6 5.5h2.9v1.3c.5-.8 1.5-1.5 3-1.5 2.5 0 3.1 1.6 3.1 3.8V15h-3V9.7c0-1.2-.2-2-1.4-2-1.3 0-1.6.9-1.6 2V15H6z",
  },
  {
    label: "GitHub",
    href: links.github,
    path: "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z",
  },
  {
    label: "YouTube",
    href: links.youtube,
    path: "M15.7 4.2a2 2 0 0 0-1.4-1.4C13 2.5 8 2.5 8 2.5s-5 0-6.3.3A2 2 0 0 0 .3 4.2C0 5.5 0 8 0 8s0 2.5.3 3.8a2 2 0 0 0 1.4 1.4c1.3.3 6.3.3 6.3.3s5 0 6.3-.3a2 2 0 0 0 1.4-1.4c.3-1.3.3-3.8.3-3.8s0-2.5-.3-3.8zM6.4 10.4V5.6L10.6 8z",
  },
  {
    label: "Email",
    href: `mailto:${contactEmail}`,
    path: "M1.5 3h13A1.5 1.5 0 0 1 16 4.5v7a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 11.5v-7A1.5 1.5 0 0 1 1.5 3zm.3 1.5L8 8.6l6.2-4.1zM1.5 5.9v5.6h13V5.9L8 10.2z",
  },
].filter((p) => p.href);
---

<footer class="foot">
  <div class="wide foot-pills">
    <div class="glass fpill">
      <Brand />
    </div>

    <nav class="glass fpill foot-nav" aria-label="Footer navigation">
      {footerNav.map((l) => <a href={l.href} class="pill-link">{l.label}</a>)}
    </nav>

    <div class="glass fpill foot-meta">
      <span class="foot-copy">© {year} {site.name}</span>
      <div class="foot-icons">
        {
          profiles.map((p) => (
            <a
              href={p.href}
              class="pill pill-line pill-icon"
              aria-label={p.label}
              {...(p.href.startsWith("mailto:") ? {} : { target: "_blank", rel: "noopener" })}
            >
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d={p.path} fill="currentColor" fill-rule="evenodd" />
              </svg>
            </a>
          ))
        }
      </div>
      <a href={bookHref} class="pill pill-fill" {...bookAttrs}>Book a call</a>
    </div>
  </div>
</footer>
