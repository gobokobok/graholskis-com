---
import { site, links } from "../config";
const year = new Date().getFullYear();
---

<footer class="wide site-foot">
  <div class="foot-row">
    <p class="meta">{site.name} · {site.role} · © {year}</p>
    <div class="foot-links">
      <a class="link" href={links.github} rel="noopener" target="_blank">GitHub</a>
      <a class="link" href={links.linkedin} rel="noopener" target="_blank">LinkedIn</a>
      {links.youtube && <a class="link" href={links.youtube} rel="noopener" target="_blank">YouTube</a>}
    </div>
  </div>
</footer>
