---
const navLinks = [
  { href: "/lab", label: "Work" },
  { href: "/frameworks", label: "Frameworks" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="wrap" style="padding-top: 24px;">
  <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    <a href="/" style="font-weight:600; font-size:14px; letter-spacing:-0.01em; text-decoration:none;" aria-label="Aleksandrs Graholskis — home">
      Aleksandrs Graholskis
    </a>
    <nav class="site-nav" aria-label="Primary navigation" style="display:flex; gap:2px; margin:0 -10px;">
      {
        navLinks.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
