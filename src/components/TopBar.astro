---
import { nav, site } from "../config";
const last = nav[nav.length - 1];
const rest = nav.slice(0, -1);
---

<header class="site-head">
  <div class="wide row">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>{site.name}</a>

    <nav class="site-nav" aria-label="Primary navigation">
      {rest.map((l) => <a href={l.href} class="hide-md">{l.label}</a>)}
      <a href={last.href} class="btn btn-primary btn-sm nav-cta">{last.label}</a>
      <details class="mnav show-md">
        <summary class="btn btn-sm" aria-label="Menu">Menu</summary>
        <ul>
          {rest.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Close the mobile menu after choosing a link.
  document.querySelectorAll<HTMLDetailsElement>(".mnav").forEach((d) => {
    d.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) d.removeAttribute("open");
    });
  });
</script>
