---
import { bookHref } from "../data/site";
const links = [
  { href: "/#cases", label: "Cases" },
  { href: "/#services", label: "Services" },
  { href: "/#products", label: "Products" },
  { href: "/#clients", label: "Clients" },
];
---

<header class="site-head">
  <div class="wide row">
    <a href="/" style="font-weight:600; font-size:17px; letter-spacing:-0.01em; text-decoration:none;" aria-label="Aleksandrs Graholskis — home">
      Aleksandrs Graholskis
    </a>
    <nav class="site-nav" aria-label="Primary navigation" style="display:flex; align-items:center; gap:2px;">
      {links.map((l) => <a href={l.href} class="hide-sm">{l.label}</a>)}
      <a href={bookHref} class="btn btn-primary btn-sm" style="margin-left:8px; color:#fff;">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  @media (max-width: 560px) {
    .hide-sm {
      display: none;
    }
  }
</style>
