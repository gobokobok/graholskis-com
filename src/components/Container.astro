---
interface Props {
  /** Visual width: "page" matches the topbar (1100px), "prose" is 42rem narrative */
  width?: "page" | "prose";
  as?: "div" | "section" | "article";
  class?: string;
}

const { width = "page", as: Tag = "div", class: extra = "" } = Astro.props;

const widthClass =
  width === "prose"
    ? "max-w-[var(--container-prose)]"
    : "max-w-[var(--container-page)]";
---

<Tag class:list={["mx-auto px-6 sm:px-12", widthClass, extra]}>
  <slot />
</Tag>
