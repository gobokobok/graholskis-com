---
// Identity at the centre: a person and the attributes that make an identity governable.
const left = ["Type", "Sponsor", "Roles"];
const right = ["Lifecycle", "Source system", "Access"];
const ys = [35, 115, 195];
const cx = 170, cy = 112;
---

<svg class="person-diagram" viewBox="0 0 340 230" role="img" aria-label="Identity model: a person at the centre with type, sponsor, roles, lifecycle, source system and access.">
  <g stroke="var(--axis)" stroke-width="1.5">
    {left.map((_, i) => <line x1="112" y1={ys[i]} x2={cx} y2={cy} />)}
    {right.map((_, i) => <line x1="228" y1={ys[i]} x2={cx} y2={cy} />)}
  </g>
  {
    left.map((l, i) => (
      <g>
        <rect x="8" y={ys[i] - 17} width="104" height="34" rx="6" style={`fill:color-mix(in oklab, var(--c${i + 1}) 14%, var(--bg)); stroke:color-mix(in oklab, var(--c${i + 1}) 55%, var(--bg));`} />
        <text x="60" y={ys[i] + 5} text-anchor="middle">{l}</text>
      </g>
    ))
  }
  {
    right.map((l, i) => (
      <g>
        <rect x="228" y={ys[i] - 17} width="104" height="34" rx="6" style={`fill:color-mix(in oklab, var(--c${i + 4}) 14%, var(--bg)); stroke:color-mix(in oklab, var(--c${i + 4}) 55%, var(--bg));`} />
        <text x="280" y={ys[i] + 5} text-anchor="middle">{l}</text>
      </g>
    ))
  }
  <circle cx={cx} cy={cy} r="40" style="fill:var(--accent-soft); stroke:var(--accent);" stroke-width="2" />
  <circle cx={cx} cy={cy - 10} r="11" style="fill:var(--accent);" />
  <path d={`M${cx - 20} ${cy + 26} a20 18 0 0 1 40 0 z`} style="fill:var(--accent);" />
  <text x={cx} y={cy + 66} text-anchor="middle" class="person-label">Person</text>
</svg>
