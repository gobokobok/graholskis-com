---
// Wordmark: initials in a filled circle plus the name, links home. Shared by the top bar and the footer.
import { site } from "../config";

interface Props {
  class?: string;
}
const { class: extra = "" } = Astro.props;
---

<a href="/" class:list={["pg-wordmark", extra]} aria-label={`${site.name}, home`}>
  <span class="pg-mark" aria-hidden="true">AG</span>
  <span class="pg-wordmark-name">{site.name}</span>
</a>
