---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";

const frameworks = [
  {
    code: "F-01",
    title: "AI Debt Assessment",
    body: "Eight-question scorecard mapping where ungoverned AI is accumulating risk and rework cost. Interactive web tool plus a 20-page diagnostic PDF.",
    status: "Flagship · launching first",
  },
  {
    code: "F-02",
    title: "Enterprise AI Governance Checklist",
    body: "EU AI Act compliance. Shadow AI remediation. AI Board structure for organisations between 1,000 and 50,000 employees.",
    status: "In draft",
  },
  {
    code: "F-03",
    title: "RAG Evaluation Framework",
    body: "Scoring rubric for enterprise retrieval pipelines. Latency, grounding, drift, cost-per-answer. Built from real production deployments.",
    status: "Outlined",
  },
  {
    code: "F-04",
    title: "Agentic Workflow Design Canvas",
    body: "A decision framework for the most expensive question in 2026 architecture: should this actually be an agent?",
    status: "Outlined",
  },
];
---

<BaseLayout
  title="Frameworks"
  description="Frameworks, checklists, and decision canvases for enterprise AI architecture and governance."
>
  <section class="bg-paper border-b-2 border-rule">
    <Container width="page" class="py-16 sm:py-24">
      <p class="eyebrow mb-5">Frameworks</p>
      <h1
        class="font-[family-name:var(--font-display)] font-extrabold text-[length:var(--text-h1)] tracking-[-0.01em] leading-[1.05] text-ink max-w-[34rem]"
      >
        Intellectual capital,<br />made tangible.
      </h1>
      <p class="prose-serif max-w-[36rem] mt-6">
        These are the documents I'd send a CIO at the start of an engagement.
        Free where useful, gated where dense — but always defensible because
        they come from the same engagements that paid for them.
      </p>
    </Container>
  </section>

  <section class="bg-paper">
    <Container width="page" class="py-12 sm:py-16">
      <ul class="border-y border-rule">
        {
          frameworks.map((f) => (
            <li class="grid sm:grid-cols-[7rem_1fr_10rem] gap-x-8 gap-y-2 py-8 border-b border-rule last:border-b-0">
              <p class="metadata text-amber">{f.code}</p>
              <div>
                <h2 class="font-[family-name:var(--font-display)] font-bold text-[22px] leading-[1.15] text-ink mb-2">
                  {f.title}
                </h2>
                <p class="prose-serif text-[15px] leading-[1.55] text-graphite">
                  {f.body}
                </p>
              </div>
              <p class="metadata text-muted sm:text-right">
                <span class="inline-block w-1.5 h-1.5 bg-amber rounded-full mr-2 align-middle" />
                {f.status}
              </p>
            </li>
          ))
        }
      </ul>

      <p class="prose-serif text-muted italic mt-10 max-w-[36rem]">
        AI Debt Assessment is the keystone — once it ships, the rest follow on
        a two-week cadence. The
        <a class="underline decoration-amber underline-offset-4" href="/contact"
          >contact page</a
        > has the most reliable way to be notified.
      </p>
    </Container>
  </section>
</BaseLayout>
