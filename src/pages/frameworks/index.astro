---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";

const frameworks = [
  {
    code: "F-01",
    title: "AI Debt Assessment",
    body: "Eight-question scorecard mapping where ungoverned AI is accumulating risk and rework cost. Interactive web tool plus a 20-page diagnostic PDF.",
    status: "Flagship · launching first",
  },
  {
    code: "F-02",
    title: "Enterprise AI Governance Checklist",
    body: "EU AI Act compliance. Shadow AI remediation. AI Board structure for organisations between 1,000 and 50,000 employees.",
    status: "In draft",
  },
  {
    code: "F-03",
    title: "RAG Evaluation Framework",
    body: "Scoring rubric for enterprise retrieval pipelines. Latency, grounding, drift, cost-per-answer. Built from real production deployments.",
    status: "Outlined",
  },
  {
    code: "F-04",
    title: "Agentic Workflow Design Canvas",
    body: "A decision framework for the most expensive question in 2026 architecture: should this actually be an agent?",
    status: "Outlined",
  },
];
---

<BaseLayout
  title="Frameworks"
  description="Frameworks, checklists, and decision canvases for enterprise AI architecture and governance."
>
  <Container as="section">
    <div style="margin-top:72px;">
      <p class="label" style="margin-bottom:12px;">Frameworks</p>
      <h1 class="h-page">Intellectual capital, made tangible.</h1>
      <p class="lede" style="margin-top:16px;">
        The documents I'd send a CIO at the start of an engagement. Free where
        useful, gated where dense, and defensible because they come from the
        engagements that paid for them.
      </p>
    </div>

    <div class="stack" style="margin-top:44px;">
      {
        frameworks.map((f) => (
          <div class="card">
            <span class="num">{f.code}</span>
            <h2 class="h-card" style="margin-top:4px;">{f.title}</h2>
            <p>{f.body}</p>
            <div class="card-foot"><span class="chip">{f.status}</span></div>
          </div>
        ))
      }
    </div>

    <p class="meta" style="margin-top:28px;">
      AI Debt Assessment is the keystone; the rest follow on a two-week
      cadence. The <a class="link" href="/contact">contact page</a> is the
      most reliable way to be notified.
    </p>
  </Container>
</BaseLayout>
