---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

/* --------------------------------------------------------------------
   HOMEPAGE — v0.1
   The 5-second authority read. Three jobs:
     1. Position (one sentence the right reader recognises themselves in)
     2. Prove (outcomes, not logos)
     3. Direct (one primary action, one secondary)
   Copy is editable starting draft. Refine in Aleksandrs's voice.
   -------------------------------------------------------------------- */

const trustOutcomes = [
  { metric: "€2M+", label: "Delivered AI outcomes" },
  { metric: "25K", label: "Person-scale deployments" },
  { metric: "6", label: "Production AI assistants" },
  { metric: "3", label: "Enterprise RAG deployments" },
];

const pillars = [
  {
    eyebrow: "01 — Lab",
    title: "Evidence over portfolio.",
    body: "Working demos, architecture diagrams, and the things that broke first. The room where I show what I've actually built — not what I claim to know.",
    href: "/lab",
    cta: "Enter the Lab",
  },
  {
    eyebrow: "02 — Frameworks",
    title: "Intellectual capital, made tangible.",
    body: "AI Debt assessment. Governance checklists. RAG evaluation rubrics. Decision canvases. Free where useful, gated where dense — but always defensible because they come from real engagements.",
    href: "/frameworks",
    cta: "Browse frameworks",
  },
  {
    eyebrow: "03 — The Work",
    title: "Audits, architecture, and advisory.",
    body: "I help enterprise leaders translate AI ambition into systems that survive contact with reality. One-week diagnostic engagements, governance design, ongoing architectural oversight.",
    href: "/contact",
    cta: "Start a conversation",
  },
];

const currentFocus = {
  label: "Agentic workflows for procurement & operations",
  updated: "May 2026",
};
---

<BaseLayout
  title="Enterprise AI Architect"
  bareTitle
  description="From AI Debt to AI Architecture. Audits, governance, and architecture for senior transformation leaders past the prototype stage."
>
  {/* ──────────────────────────  HERO  ────────────────────────── */}
  <section class="bg-paper relative overflow-hidden border-b-2 border-rule">
    {/* huge ghost wordmark — atmosphere, not decoration */}
    <span
      aria-hidden="true"
      class="pointer-events-none select-none absolute -right-4 -bottom-6 font-[family-name:var(--font-display)] font-extrabold text-[clamp(120px,18vw,260px)] leading-none tracking-[-0.04em] text-ink/[0.03] whitespace-nowrap"
    >
      ARCHITECT
    </span>

    <Container width="page" as="div" class="relative py-16 sm:py-24">
      <div class="grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-end">
        <div class="arrive">
          <div
            class="eyebrow flex items-center gap-3 mb-5"
            style="--i:0"
          >
            <span>Strategic AI Practice</span>
            <span class="block h-px w-10 bg-amber"></span>
            <span class="text-muted normal-case tracking-[0.14em]"
              >Tallinn / EU</span
            >
          </div>

          <h1
            class="font-[family-name:var(--font-display)] font-extrabold text-[length:var(--text-display)] tracking-[-0.02em] leading-[1.0] text-ink mb-6 arrive-stagger"
            style="--i:1"
          >
            From <em
              class="font-[family-name:var(--font-serif)] italic font-normal text-amber"
              >AI Debt</em
            ><br />to AI <em
              class="font-[family-name:var(--font-serif)] italic font-normal text-amber"
              >Architecture</em
            >.
          </h1>

          <p
            class="prose-serif max-w-[36rem] border-l-2 border-amber pl-5 arrive-stagger"
            style="--i:2"
          >
            I help enterprise leaders translate AI ambition into systems that
            survive contact with reality. <strong
              >Audits, governance, and architecture</strong
            > for organisations past the prototype stage — where the cost of
            getting it wrong has stopped being theoretical.
          </p>

          <div
            class="mt-8 flex flex-wrap items-center gap-3 arrive-stagger"
            style="--i:3"
          >
            <a
              href="/contact"
              class="inline-flex items-center gap-2 bg-ink text-paper px-5 py-3 text-[10px] tracking-[0.18em] uppercase border-2 border-ink hover:bg-amber hover:border-amber transition-colors"
            >
              Start an audit
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="/lab"
              class="inline-flex items-center gap-2 px-5 py-3 text-[10px] tracking-[0.18em] uppercase border-2 border-ink/15 text-graphite hover:border-amber hover:text-ink transition-colors"
            >
              See the work
            </a>
          </div>
        </div>

        {/* current focus card — small, restrained */}
        <aside
          class="arrive-stagger lg:max-w-[14rem] border-l border-rule lg:pl-8"
          style="--i:4"
          aria-label="Current focus"
        >
          <p class="metadata mb-2">
            <span class="inline-block w-1.5 h-1.5 bg-amber rounded-full mr-2 align-middle animate-pulse"
            ></span>
            Now
          </p>
          <p
            class="font-[family-name:var(--font-serif)] text-[15px] leading-[1.4] text-ink"
          >
            {currentFocus.label}
          </p>
          <p class="metadata mt-3 text-muted">
            Updated {currentFocus.updated}
          </p>
        </aside>
      </div>
    </Container>
  </section>

  {/* ──────────────────────────  TRUST BAR  ────────────────────────── */}
  <section class="bg-ink text-paper" aria-label="Outcomes delivered">
    <Container width="page" class="py-8 sm:py-10">
      <p class="metadata text-amber mb-5">Outcomes, not logos</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-6">
        {
          trustOutcomes.map((o) => (
            <div class="border-l border-paper/10 pl-4 first:border-l-0 first:pl-0 sm:border-l sm:pl-4 sm:first:border-l">
              <p class="font-[family-name:var(--font-display)] font-extrabold text-[clamp(28px,3.5vw,40px)] leading-none text-amber">
                {o.metric}
              </p>
              <p class="metadata text-paper/45 mt-2">{o.label}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* ──────────────────────────  PILLARS  ────────────────────────── */}
  <section class="bg-paper" aria-label="Three doors into the work">
    <Container width="page" class="py-16 sm:py-24">
      <header class="mb-12 max-w-[44rem]">
        <p class="eyebrow mb-4">The three rooms</p>
        <h2
          class="font-[family-name:var(--font-display)] font-bold text-[length:var(--text-h1)] leading-[1.1] tracking-[-0.01em] text-ink"
        >
          Evidence, frameworks, and engagement — in that order.
        </h2>
        <p class="prose-serif mt-4">
          Most consultants lead with credentials. I lead with what I've
          built, what I've codified, and only then what I'll do with you.
          Each room earns the next.
        </p>
      </header>

      <div class="grid md:grid-cols-3 border-t border-rule">
        {
          pillars.map((p, idx) => (
            <a
              href={p.href}
              class="group relative block p-8 border-b border-rule md:border-b-0 md:border-r border-rule last:border-r-0 hover:bg-surface/60 transition-colors"
            >
              <p class="metadata text-amber mb-6">{p.eyebrow}</p>
              <h3 class="font-[family-name:var(--font-display)] font-bold text-[22px] leading-[1.15] text-ink mb-3 transition-colors group-hover:text-amber">
                {p.title}
              </h3>
              <p class="prose-serif text-[15px] leading-[1.55] text-graphite mb-8">
                {p.body}
              </p>
              <span class="inline-flex items-center gap-2 text-[10px] tracking-[0.18em] uppercase text-ink border-b border-ink pb-1 group-hover:text-amber group-hover:border-amber transition-colors">
                {p.cta}
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
              <span
                aria-hidden="true"
                class="absolute top-6 right-6 font-[family-name:var(--font-display)] font-extrabold text-[40px] text-ink/[0.05] leading-none"
              >
                0{idx + 1}
              </span>
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  {/* ──────────────────────────  CTA BAND  ────────────────────────── */}
  <section class="bg-ink text-paper" aria-labelledby="cta-heading">
    <Container width="page" class="py-14 sm:py-16">
      <div
        class="grid sm:grid-cols-[1fr_auto] gap-8 items-center"
      >
        <div>
          <p class="eyebrow mb-4">For senior transformation leaders</p>
          <h2
            id="cta-heading"
            class="font-[family-name:var(--font-display)] font-bold text-[length:var(--text-h1)] leading-[1.1] text-paper max-w-[32rem]"
          >
            Considering an AI audit? Let's see if it's the right call.
          </h2>
          <p
            class="font-[family-name:var(--font-serif)] italic font-light text-[16px] mt-4 text-paper/70 max-w-[36rem]"
          >
            A 30-minute discovery call. No pitch deck, no follow-up sequence
            — just whether I'm the right person for what you're trying to
            do.
          </p>
        </div>
        <a
          href="/contact"
          class="inline-flex items-center gap-3 bg-amber text-ink px-7 py-4 text-[10px] tracking-[0.18em] uppercase font-medium border-2 border-amber hover:bg-paper transition-colors justify-self-start sm:justify-self-end"
        >
          Book the call
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
