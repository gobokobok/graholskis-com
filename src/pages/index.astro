---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

const proof = [
  { metric: "€2M+", label: "Savings delivered" },
  { metric: "8", label: "Enterprise clients" },
  { metric: "25K+", label: "Employees impacted" },
];

const work = [
  {
    label: "Lab",
    title: "Evidence over portfolio",
    body: "Working demos, architecture diagrams, and the things that broke first.",
    href: "/lab",
  },
  {
    label: "Frameworks",
    title: "Intellectual capital, made tangible",
    body: "AI Debt assessment, governance checklists, RAG evaluation rubrics, decision canvases.",
    href: "/frameworks",
  },
];
---

<BaseLayout
  title="Enterprise AI Architect"
  bareTitle
  description="From AI Debt to AI Architecture. Audits, governance, and architecture for senior transformation leaders past the prototype stage."
>
  <Container as="section" class="" >
    <div style="margin-top:96px;">
      <h1 class="h-hero">From AI debt<br />to AI architecture.</h1>
      <p class="lede" style="margin-top:24px;">
        I help enterprise leaders translate AI ambition into systems that
        survive contact with reality. Audits, governance, and architecture
        for organisations past the prototype stage.
      </p>
      <div style="margin-top:32px; display:flex; gap:20px; align-items:center; flex-wrap:wrap;">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href="/frameworks" class="link">See the frameworks</a>
      </div>
    </div>

    <div class="section proof" aria-label="Outcomes delivered">
      {
        proof.map((p) => (
          <div class="card">
            <p class="proof-num">{p.metric}</p>
            <p class="label">{p.label}</p>
          </div>
        ))
      }
    </div>

    <div class="section">
      <p class="label" style="margin-bottom:12px;">Work</p>
      <div class="stack">
        {
          work.map((w) => (
            <a href={w.href} class="card">
              <span class="num">{w.label}</span>
              <h2 class="h-card" style="margin-top:4px;">{w.title}</h2>
              <p>{w.body}</p>
            </a>
          ))
        }
      </div>
    </div>

    <div class="section">
      <p class="label" style="margin-bottom:12px;">About</p>
      <div class="prose">
        <p>
          I'm <strong>Aleksandrs Graholskis</strong>, an enterprise AI
          architect working with CIOs, transformation leaders and governance
          functions across Europe. I focus on the part of the AI lifecycle most
          teams skip: the architecture that decides whether a prototype
          becomes a production system or quietly turns into AI debt.
        </p>
      </div>
      <a href="/about" class="link">More about me</a>
    </div>

    <div class="section">
      <p class="label" style="margin-bottom:12px;">Contact</p>
      <h2 class="h-page">Considering an AI audit?</h2>
      <p class="lede" style="margin-top:12px;">
        A 30-minute conversation. No pitch deck, no follow-up sequence, just
        whether this is the right engagement for what you're trying to do.
      </p>
      <div style="margin-top:24px;">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
      </div>
    </div>
  </Container>
</BaseLayout>
