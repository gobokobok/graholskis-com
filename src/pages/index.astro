---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import WorkVisual from "../components/WorkVisual.astro";
import LabTile from "../components/LabTile.astro";
import ResourceCard from "../components/ResourceCard.astro";
import {
  site,
  bookHref,
  bookLabel,
  services,
  work,
  workHeading,
  heroPhoto,
  labs,
  workshops,
  resources,
  background,
  links,
} from "../config";

const anyCheckout = resources.some((r) => r.checkoutUrl);
---

<BaseLayout title={site.role} bareTitle description={site.tagline}>
  {/* 1. HERO */}
  <section class="hero hero-pos">
    <Container wide>
      <div class="hero-grid hero-split">
        <div>
          <h1 class="h-hero hero-h1">
            From AI experiments to <mark>governed adoption</mark>
          </h1>
          <p class="lede hero-sub">
            I build working AI solutions, design the platform that keeps them under control, and train
            teams to use them. 15 years in enterprise architecture, now applied to AI.
          </p>
          <div class="hero-links">
            <a href={bookHref} class="btn btn-primary">{bookLabel}</a>
            <a href="#work" class="link link-arrow">See what I have built <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="photo hero-photo">
          {heroPhoto.src ? <img src={heroPhoto.src} alt={heroPhoto.alt} width="720" height="960" fetchpriority="high" /> : <span class="photo-ph">Photo</span>}
        </div>
      </div>
    </Container>
  </section>

  {/* 2. WHAT I DO */}
  <section id="services" class="band band-soft">
    <Container wide>
      <div class="sec-head">
        <h2 class="h-sec">What I do</h2>
      </div>
      <div class="grid-3">
        {
          services.map((s, i) => (
            <div class="card mode" style={`--nc: var(--c${i + 1})`}>
              <h3 class="h-card mode-title">{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* 3. WORK */}
  <section id="work" class="band">
    <Container wide>
      <div class="sec-head">
        <h2 class="h-sec">{workHeading}</h2>
      </div>
      <div class="case-grid">
        {
          work.map((w) => (
            <article class="card case-card">
              <div class="case-visual">
                <WorkVisual item={w} />
              </div>
              <h3>{w.title}</h3>
              <p>{w.summary}</p>
              {w.badge && (
                <div class="chips"><span class="chip">{w.badge}</span></div>
              )}
              <div class="work-links">
                {w.caseHref && <a href={w.caseHref} class="more">Read case →</a>}
                {w.liveHref && (
                  <a href={w.liveHref} class="more" rel="noopener" target="_blank">Live tool ↗</a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  {/* 4. LABS */}
  <section id="labs" class="band band-soft">
    <Container wide>
      <div class="sec-head sec-head-row">
        <h2 class="h-sec">Labs</h2>
        {links.youtube && <a href={links.youtube} class="link link-arrow" rel="noopener" target="_blank">YouTube channel ↗</a>}
      </div>
      <div class="lab-grid">
        {labs.map((l) => <LabTile item={l} />)}
      </div>
    </Container>
  </section>

  {/* 5. WORKSHOPS */}
  <section id="workshops" class="band">
    <Container wide>
      <div class="sec-head">
        <h2 class="h-sec">Workshops</h2>
      </div>
      <div class="grid-3">
        {
          workshops.topics.map((t) => (
            <article class="card ws-card">
              <h3 class="h-card">{t.title}</h3>
              <p>{t.summary}</p>
              <a href={`/workshops/${t.slug}`} class="more">Details →</a>
            </article>
          ))
        }
      </div>
      <p class="formats"><strong>Formats:</strong> {workshops.formats}</p>
      {
        workshops.testimonial && (
          <figure class="quote" style="margin-top:48px;">
            <p>“{workshops.testimonial.quote}”</p>
            <footer>{workshops.testimonial.by}</footer>
          </figure>
        )
      }
    </Container>
  </section>

  {/* 7. RESOURCES */}
  <section id="resources" class="band band-soft">
    <Container wide>
      <div class="sec-head">
        <h2 class="h-sec">Resources</h2>
      </div>
      <div class="grid-3">
        {resources.map((r) => <ResourceCard item={r} />)}
      </div>
    </Container>
  </section>

  {/* 8. BACKGROUND */}
  <section class="band" aria-labelledby="bg-h">
    <Container wide>
      <div class="case-row">
        <h2 id="bg-h" class="h-sec">Background</h2>
        <div class="case-text">
          <p class="case-lead">{background}</p>
          <p><a href="/earlier-work" class="link">Earlier work</a></p>
        </div>
      </div>
    </Container>
  </section>

  {anyCheckout && <script is:inline src="https://assets.lemonsqueezy.com/lemon.js" defer></script>}
</BaseLayout>
