---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

const trustOutcomes = [
  { metric: "€2M+", label: "Savings delivered" },
  { metric: "8",    label: "Enterprise clients" },
  { metric: "4",    label: "Industries served" },
  { metric: "25K+", label: "Employees impacted" },
];

const pillars = [
  {
    eyebrow: "01 — Lab",
    title: "Evidence over portfolio.",
    body: "Working demos, architecture diagrams, and the things that broke first. The room where I show what I've actually built — not what I claim to know.",
    href: "/lab",
    cta: "Enter the Lab",
  },
  {
    eyebrow: "02 — Frameworks",
    title: "Intellectual capital, made tangible.",
    body: "AI Debt assessment. Governance checklists. RAG evaluation rubrics. Decision canvases. Free where useful, gated where dense.",
    href: "/frameworks",
    cta: "Browse frameworks",
  },
  {
    eyebrow: "03 — Work with me",
    title: "Audits, architecture, advisory.",
    body: "I help enterprise leaders translate AI ambition into systems that survive contact with reality. One-week diagnostic engagements, governance design, ongoing architectural oversight.",
    href: "/contact",
    cta: "Start a conversation",
  },
];

const currentFocus = {
  text: "Agentic workflows for procurement & operations",
  updated: "May 2026",
};
---

<BaseLayout
  title="Enterprise AI Architect"
  bareTitle
  description="From AI Debt to AI Architecture. Audits, governance, and architecture for senior transformation leaders past the prototype stage."
>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━  HERO  ━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section class="bg-paper border-b-2 border-[var(--color-rule)]">

    <Container width="page" as="div" class="pt-20 pb-24 sm:pt-28 sm:pb-32">

      <div class="grid lg:grid-cols-[1fr_18rem] gap-12 lg:gap-20 items-end">

        {/* ── Left: headline + CTA ── */}
        <div>

          <h1
            class="font-[family-name:var(--font-display)] font-extrabold text-[length:var(--text-display)] tracking-[-0.025em] leading-[1.0] text-[var(--color-ink)] mb-8"
          >
            From <em class="font-[family-name:var(--font-serif)] italic font-normal text-[var(--color-amber)]">AI Debt</em><br />
            to AI <em class="font-[family-name:var(--font-serif)] italic font-normal text-[var(--color-amber)]">Architecture</em>.
          </h1>

          <p class="font-[family-name:var(--font-sans)] text-[18px] leading-[1.7] text-[var(--color-graphite)] max-w-[34rem]">
            I help enterprise leaders translate AI ambition into systems
            that survive contact with reality.
            <strong>Audits, governance, and architecture</strong> for
            organisations past the prototype stage — where the cost of
            getting it wrong has stopped being theoretical.
          </p>

          <div class="mt-10">
            <a
              href="/contact"
              class="btn-primary"
            >
              Start an audit
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        {/* ── Right: current focus ── */}
        <aside
          class="arrive-stagger lg:pb-2 border-l border-[var(--color-rule)] pl-8"
          style="--i:4"
          aria-label="Current focus"
        >
          <p class="label mb-3 flex items-center gap-2">
            <span class="w-2 h-2 bg-[var(--color-amber)] rounded-full animate-pulse inline-block"></span>
            Now
          </p>
          <p class="font-[family-name:var(--font-serif)] text-[17px] leading-[1.45] text-[var(--color-ink)]">
            {currentFocus.text}
          </p>
          <p class="label text-[var(--color-muted)] mt-4">
            Updated {currentFocus.updated}
          </p>
        </aside>

      </div>
    </Container>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━  TRUST BAR  ━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section class="bg-[var(--color-ink)] w-full" aria-label="Outcomes delivered">
    <div class="py-14 sm:py-16 px-6 sm:px-12">
      <div class="grid grid-cols-2 sm:grid-cols-4 max-w-5xl mx-auto divide-x divide-white/10">
        {trustOutcomes.map((o) => (
          <div class="min-w-0 overflow-hidden text-center px-8 sm:px-10">
            {/* fixed-height wrapper anchors all numerals to the same baseline */}
            <div class="h-12 flex items-center justify-center">
              <p
                class="font-[family-name:var(--font-display)] font-extrabold text-[var(--color-amber)] leading-none"
                style="font-size: clamp(26px, 2.8vw, 40px)"
              >
                {o.metric}
              </p>
            </div>
            <p class="font-[family-name:var(--font-mono)] text-[12px] font-medium tracking-[0.14em] uppercase text-white/65 mt-3">
              {o.label}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━  THREE PILLARS  ━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section class="bg-paper" aria-label="Three entry points">
    <Container width="page" class="pt-20 pb-24 sm:pt-28 sm:pb-32">

      <header class="mb-16 max-w-[42rem]">
        <h2
          class="font-[family-name:var(--font-display)] font-bold leading-[1.1] tracking-[-0.015em] text-[var(--color-ink)]"
          style="font-size: clamp(2rem, 3.6vw, 3.2rem)"
        >
          Evidence, frameworks, and engagement — in that order.
        </h2>
        <p class="mt-6 text-[18px] leading-[1.6] text-[var(--color-graphite)] font-[family-name:var(--font-sans)]">
          Most consultants lead with credentials. I lead with what I've
          built, what I've codified, and only then what I'll do with you.
          Each room earns the next.
        </p>
      </header>

      <div class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[var(--color-rule)] border border-[var(--color-rule)]">
        {pillars.map((p, idx) => (
          <a
            href={p.href}
            class="group relative block p-10 hover:bg-[var(--color-surface)] transition-colors"
          >
            {/* superheading label */}
            <p class="eyebrow text-[var(--color-amber)] mb-6">{p.eyebrow}</p>

            <h3
              class="font-[family-name:var(--font-display)] font-bold text-[length:var(--text-h3)] leading-[1.2] text-[var(--color-ink)] mb-4 group-hover:text-[var(--color-amber)] transition-colors"
            >
              {p.title}
            </h3>
            <p class="text-[16px] leading-[1.65] text-[var(--color-graphite)]">
              {p.body}
            </p>

            {/* directional arrow — bottom-right, signals the card is a link */}
            <span
              aria-hidden="true"
              class="absolute bottom-8 right-8 text-[18px] leading-none text-[var(--color-ink)]/25 group-hover:text-[var(--color-amber)] group-hover:translate-x-1 transition-all"
            >→</span>
          </a>
        ))}
      </div>

    </Container>
  </section>

  {/* ━━━━━━━━━━━━━━━━━━━━━━━━  CLOSING CTA  ━━━━━━━━━━━━━━━━━━━━━━━━ */}
  <section class="bg-[var(--color-ink)]" aria-labelledby="cta-heading">
    <Container width="page" class="py-20 sm:py-24">
      <div class="grid sm:grid-cols-[1fr_auto] gap-10 items-center">
        <div>
          <p class="eyebrow text-[var(--color-amber)] mb-5" style="font-size: 12px">For senior transformation leaders</p>
          <h2
            id="cta-heading"
            class="font-[family-name:var(--font-display)] font-extrabold text-[length:var(--text-h1)] leading-[1.1] text-[var(--color-paper)] max-w-[28rem]"
          >
            Considering an AI audit?
          </h2>
          <p class="font-[family-name:var(--font-sans)] text-[18px] mt-5 text-white/65 max-w-[34rem] leading-[1.65]">
            A 30-minute conversation. No pitch deck, no follow-up
            sequence — just whether this is the right engagement for
            what you're trying to do.
          </p>
        </div>
        <a
          href="/contact"
          class="inline-flex items-center gap-3 bg-[var(--color-amber)] text-[var(--color-ink)] px-8 py-5 text-[14px] tracking-[0.14em] uppercase font-medium border-2 border-[var(--color-amber)] hover:bg-[var(--color-paper)] transition-colors whitespace-nowrap justify-self-start sm:justify-self-end"
        >
          Book the call
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </section>

</BaseLayout>
