---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";

const incoming = [
  {
    eyebrow: "Demo · Phase 2",
    title: "Production AI Assistants",
    body: "Six production assistants across procurement, HR, and analytics. Architecture diagrams, retrieval design, evaluation harness.",
    status: "Shipping in this site phase",
  },
  {
    eyebrow: "Tool · Phase 2",
    title: "RAG Scorecard",
    body: "Five questions about your current retrieval setup → instant score and personalised recommendations. No signup.",
    status: "Building",
  },
  {
    eyebrow: "Architectures",
    title: "Reference Diagrams",
    body: "Enterprise AI Gateway. TOGAF-AI phase model. Shadow AI remediation flow. Each with a short, honest caption.",
    status: "Drafting",
  },
  {
    eyebrow: "Anti-portfolio · Phase 4",
    title: "What Broke",
    body: "Anonymised failure post-mortems. The €200K decision made under pressure. The bot that overran $200 in API costs overnight. Real engineering, real lessons.",
    status: "Awaiting NDA review",
  },
];
---

<BaseLayout
  title="The Lab"
  description="Working demos, architecture diagrams, and post-mortems. The evidence room — not a portfolio."
>
  <section class="bg-paper border-b-2 border-rule">
    <Container width="page" class="py-16 sm:py-24">
      <p class="eyebrow mb-5">The Lab</p>
      <h1
        class="font-[family-name:var(--font-display)] font-extrabold text-[length:var(--text-h1)] tracking-[-0.01em] leading-[1.05] text-ink max-w-[32rem]"
      >
        Evidence over portfolio.<br />Not what I claim to know — what I've
        actually built.
      </h1>
      <p class="prose-serif max-w-[36rem] mt-6">
        Most consulting sites lead with logos. This room leads with
        architecture diagrams, working demos, and the things that broke
        first. Use it to decide whether I think the way you'd want an
        architect to think.
      </p>
    </Container>
  </section>

  <section class="bg-paper">
    <Container width="page" class="py-12 sm:py-16">
      <ul class="grid md:grid-cols-2 gap-px bg-rule border border-rule">
        {
          incoming.map((item) => (
            <li class="bg-paper p-7 sm:p-9 flex flex-col gap-4">
              <p class="metadata text-amber">{item.eyebrow}</p>
              <h2 class="font-[family-name:var(--font-display)] font-bold text-[20px] leading-[1.2] text-ink">
                {item.title}
              </h2>
              <p class="prose-serif text-[15px] leading-[1.55] text-graphite">
                {item.body}
              </p>
              <p class="metadata mt-auto text-muted">
                <span class="inline-block w-1.5 h-1.5 bg-amber rounded-full mr-2 align-middle" />
                {item.status}
              </p>
            </li>
          ))
        }
      </ul>

      <p class="prose-serif text-muted italic mt-10 max-w-[36rem]">
        These pages are landing in sequence over the next three weeks.
        Following along is welcome — the
        <a class="underline decoration-amber underline-offset-4" href="/contact">contact page</a>
        is the easiest way to be told when each one ships.
      </p>
    </Container>
  </section>
</BaseLayout>
