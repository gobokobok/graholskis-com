---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";

const incoming = [
  {
    label: "Demo",
    title: "Production AI Assistants",
    body: "Six production assistants across procurement, HR, and analytics. Architecture diagrams, retrieval design, evaluation harness.",
    status: "Shipping next",
  },
  {
    label: "Tool",
    title: "RAG Scorecard",
    body: "Five questions about your current retrieval setup, then an instant score and personalised recommendations. No signup.",
    status: "Building",
  },
  {
    label: "Architectures",
    title: "Reference Diagrams",
    body: "Enterprise AI Gateway. TOGAF-AI phase model. Shadow AI remediation flow. Each with a short, honest caption.",
    status: "Drafting",
  },
  {
    label: "Anti-portfolio",
    title: "What Broke",
    body: "Anonymised failure post-mortems: the €200K decision made under pressure, the bot that overran $200 in API costs overnight.",
    status: "Awaiting NDA review",
  },
];
---

<BaseLayout
  title="Work"
  description="Working demos, architecture diagrams, and post-mortems. The evidence room, not a portfolio."
>
  <Container as="section">
    <div style="margin-top:72px;">
      <p class="label" style="margin-bottom:12px;">Work</p>
      <h1 class="h-page">Not what I claim to know. What I've built.</h1>
      <p class="lede" style="margin-top:16px;">
        Architecture diagrams, working demos, and the things that broke first.
        Use it to decide whether I think the way you'd want an architect to
        think.
      </p>
    </div>

    <div class="stack" style="margin-top:44px;">
      {
        incoming.map((item) => (
          <div class="card">
            <span class="num">{item.label}</span>
            <h2 class="h-card" style="margin-top:4px;">{item.title}</h2>
            <p>{item.body}</p>
            <div class="card-foot"><span class="chip">{item.status}</span></div>
          </div>
        ))
      }
    </div>

    <p class="meta" style="margin-top:28px;">
      These pages are landing in sequence. The
      <a class="link" href="/contact">contact page</a> is the easiest way to be told when each one ships.
    </p>
  </Container>
</BaseLayout>
