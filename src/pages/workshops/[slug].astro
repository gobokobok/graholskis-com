---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { workshops, bookHref, bookLabel } from "../../config";

export function getStaticPaths() {
  return workshops.topics.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
---

<BaseLayout title={t.title} description={t.summary}>
  <section class="hero" style="padding-bottom:96px;">
    <Container wide>
      <a href="/#workshops" class="link" style="font-size:16px;">← All workshops</a>
      <h1 class="h-sec case-title">{t.title}</h1>
      <p class="lede" style="margin-top:28px;">{t.summary}</p>
      <p class="formats" style="margin-top:32px;"><strong>Formats:</strong> {workshops.formats}</p>
      <div class="hero-links">
        <a href={bookHref} class="btn btn-primary">{bookLabel}</a>
      </div>
    </Container>
  </section>
  {
    t.details.length > 0 && (
      <section class="band band-soft">
        <Container wide>
          <div class="grid-2">
            {t.details.map((d) => (
              <div class="card">
                <h2 class="h-card">{d.title}</h2>
                <p>{d.body}</p>
              </div>
            ))}
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>
