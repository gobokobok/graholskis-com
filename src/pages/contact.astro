---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

/* Replace `calendlyUrl` with your real link. Until then, the button falls back to mailto. */
const calendlyUrl = ""; // e.g. "https://calendly.com/graholskis/discovery"
const emailAddress = "alex@graholskis.com"; // placeholder: confirm with Aleksandrs

const ctaHref = calendlyUrl || `mailto:${emailAddress}?subject=Discovery call`;
const ctaLabel = calendlyUrl ? "Book a 30-minute call" : "Email to schedule";
---

<BaseLayout
  title="Contact"
  description="Book a 30-minute discovery call. No pitch, no sequence, just whether the engagement makes sense."
>
  <Container as="article">
    <div style="margin-top:72px;">
      <p class="label" style="margin-bottom:12px;">Contact</p>
      <h1 class="h-page">A 30-minute conversation, or a written message.</h1>
    </div>

    <div class="prose" style="margin-top:28px; font-size:18px; line-height:1.6;">
      <p>
        The discovery call is for senior leaders evaluating whether an external
        architect makes sense for what they are building. It is a working
        conversation, not a sales call. If the engagement isn't a fit, I'll say
        so and point you to someone closer.
      </p>
    </div>

    <div style="margin-top:28px; display:flex; gap:12px; flex-wrap:wrap;">
      <a href={ctaHref} class="btn btn-primary">{ctaLabel}</a>
      <a href={`mailto:${emailAddress}`} class="btn">Email directly</a>
    </div>

    <div class="section">
      <p class="label" style="margin-bottom:12px;">Elsewhere</p>
      <div class="stack">
        <a class="card" href={`mailto:${emailAddress}`}>
          <p class="meta">Email</p>
          <h2 class="h-card" style="margin-top:2px;">{emailAddress}</h2>
        </a>
        <a class="card" href="https://www.linkedin.com/in/aleksandrs-graholskis/" rel="noopener" target="_blank">
          <p class="meta">LinkedIn</p>
          <h2 class="h-card" style="margin-top:2px;">aleksandrs-graholskis</h2>
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>
