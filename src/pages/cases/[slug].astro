---
// Case page on the Pill & Glow kit (kit.css; layout in case.css). Content comes from src/data/cases.ts,
// every case follows the same parts: header, request, challenges, solution, outcome, lessons, links, call to action.
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseVisual from "../../components/CaseVisual.astro";
import { cases, type Case } from "../../data/cases";
import { links as siteLinks } from "../../config";
import "../../styles/case.css";

export function getStaticPaths() {
  return cases.map((c, i) => ({
    params: { slug: c.slug },
    props: { c, next: cases[(i + 1) % cases.length] },
  }));
}

const { c, next } = Astro.props as { c: Case; next: Case };

const linkMeta = {
  product: { title: "Open the product", kind: "Live product" },
  code: { title: "Code on GitHub", kind: "Repository" },
  project: { title: "Project on GitHub", kind: "Project notes" },
  video: { title: "Watch the walkthrough", kind: "YouTube" },
} as const;
const links = c.links
  ? (Object.keys(linkMeta) as (keyof typeof linkMeta)[])
      .filter((k) => c.links![k])
      .map((k) => ({ ...linkMeta[k], ...c.links![k]! }))
  : [];
const primary = links.find((l) => l.href);
// "Python, FastAPI, ..., Railway." shown as pills
const stack = c.solution.stack.replace(/\.$/, "").split(/,\s*/);
---

<BaseLayout title={c.title} description={c.summary} kit>
  {/* 1. HEADER: a dark block with the product screenshots */}
  <section class="pg-section pg-dark glow cs-hero">
    <div class="pg-container">
      <a href="/#work" class="pg-link cs-back">← All cases</a>
      <h1 class="pg-h1 cs-title">{c.title}</h1>
      <p class="pg-lead">{c.summary}</p>
      {
        primary && (
          <div class="cs-actions">
            <a href={primary.href} class="pg-btn pg-btn-primary" rel="noopener" target="_blank">{primary.title} ↗</a>
          </div>
        )
      }
      {c.placeholder && <span class="pg-pill pg-pill-dashed">Draft content</span>}
      <dl class="cs-meta">
        {
          c.meta.map((m) => (
            <div class="pg-card">
              <dt class="pg-label">{m.k}</dt>
              <dd>{m.v}</dd>
            </div>
          ))
        }
      </dl>
      {
        c.showcase && (
          <div class="cs-showcase" role="img" aria-label={c.showcase.alt}>
            <div class="cs-desktop">
              <img src={c.showcase.desktop} alt="" width="1600" height="859" />
            </div>
            <div class="cs-phones">
              {c.showcase.mobile.map((m) => (
                <div class="cs-phone">
                  <img src={m} alt="" width="570" height="1090" />
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {/* 2. BUSINESS REQUEST */}
  <section class="pg-section">
    <div class="pg-container">
      <div class="pg-head">
        <h2 class="pg-h1">Business request</h2>
      </div>
      <div class="cs-text">
        {c.request.map((p) => <p class="pg-lead">{p}</p>)}
      </div>
    </div>
  </section>

  {/* 3. CHALLENGES */}
  <section class="pg-section">
    <div class="pg-container">
      <div class="pg-head">
        <h2 class="pg-h1">Challenges</h2>
      </div>
      <ul class="cs-cards">
        {
          c.challenges.map((ch, i) => (
            <li class="pg-card pg-reveal" style={`--i:${i}`}>
              {typeof ch === "string" ? (
                <p class="pg-body">{ch}</p>
              ) : (
                <>
                  <h3 class="pg-h3">{ch.title}</h3>
                  <p class="pg-small">{ch.body}</p>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 4. DELIVERED SOLUTION */}
  <section class="pg-section">
    <div class="pg-container">
      <div class="pg-head">
        <h2 class="pg-h1">Delivered solution</h2>
      </div>
      <div class="cs-text">
        {c.solution.intro.map((p) => <p class="pg-lead">{p}</p>)}
      </div>

      {
        c.solution.showVisual && (
          <div class="pg-card cs-block pg-reveal">
            <h3 class="pg-label">Pipeline flow</h3>
            <div class="pg-inner cs-visual">
              <CaseVisual visual={c.visual} fit />
            </div>
          </div>
        )
      }

      {
        c.solution.parts && (
          <ul class="cs-cards cs-block">
            {c.solution.parts.map((p, i) => (
              <li class="pg-card pg-reveal" style={`--i:${i}`}>
                <h3 class="pg-h3">{p.title}</h3>
                <p class="pg-small">{p.body}</p>
              </li>
            ))}
          </ul>
        )
      }

      {c.solution.outro && <div class="cs-text cs-block">{c.solution.outro.map((p) => <p class="pg-body">{p}</p>)}</div>}

      {
        c.solution.points && (
          <div class="pg-card cs-block pg-reveal">
            <h3 class="pg-h3">{c.solution.points.title}</h3>
            <ul class="cs-rows">
              {c.solution.points.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        )
      }

      <div class="cs-stack cs-block">
        <h3 class="pg-label">Tech stack</h3>
        <ul class="cs-pills">
          {stack.map((s) => <li class="pg-pill">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* 5. OUTCOME: a dark band */}
  <div class="pg-dark pg-dark-band">
    <section class="pg-section">
      <div class="pg-container">
        <div class="pg-head">
          <h2 class="pg-h1">Outcome</h2>
        </div>
        {
          c.figures && (
            <div class="cs-figures">
              {c.figures.map((f, i) => (
                <div class="pg-card pg-reveal" style={`--i:${i}`}>
                  <p class="pg-stat pg-accent-text">{f.metric}</p>
                  <p class="pg-small">{f.label}</p>
                </div>
              ))}
            </div>
          )
        }
        {c.outcomeAsList ? (
          <div class="pg-card cs-outcome pg-reveal">
            <ul class="cs-rows">
              {c.outcome.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        ) : (
          <div class="cs-text">{c.outcome.map((p) => <p class="pg-lead">{p}</p>)}</div>
        )}
      </div>
    </section>
  </div>

  {/* 6. LESSONS LEARNED */}
  <section class="pg-section">
    <div class="pg-container">
      <div class="pg-head">
        <h2 class="pg-h1">Lessons learned</h2>
      </div>
      <ul class="cs-cards">
        {
          c.lessons.map((l, i) => (
            <li class="pg-card pg-reveal" style={`--i:${i}`}>
              <p class="pg-body">{l}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* LINKS (only when a case has them) */}
  {
    links.length > 0 && (
      <section class="pg-section">
        <div class="pg-container">
          <div class="pg-head">
            <h2 class="pg-h1">See it for yourself</h2>
          </div>
          <div class="pg-grid-3">
            {links.map((l, i) =>
              l.href ? (
                <a href={l.href} class="pg-card cs-link pg-reveal" style={`--i:${i}`} rel="noopener" target="_blank">
                  <span class="pg-label">{l.kind}</span>
                  <h3 class="pg-h3">{l.title} ↗</h3>
                  <p class="pg-small">{l.note}</p>
                </a>
              ) : (
                <div class="pg-card pg-reveal" style={`--i:${i}`}>
                  <span class="pg-label">{l.kind}</span>
                  <h3 class="pg-h3">{l.title}</h3>
                  <p class="pg-small">{l.note}</p>
                  <div class="pg-card-foot">
                    <span class="pg-pill pg-pill-dashed">Coming soon</span>
                  </div>
                </div>
              ),
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* CALL TO ACTION (kit CTA band: inverse card) + NEXT CASE */}
  <section class="pg-section">
    <div class="pg-container">
      <div class="pg-card pg-card-inverse cs-cta">
        <div>
          <h2 class="pg-h1">Have a project like this?</h2>
          <p class="pg-lead">A 30-minute call to see whether I can help.</p>
        </div>
        <div class="cs-cta-actions">
          <a href="/#contact" class="pg-btn pg-btn-primary">Get in touch</a>
          <a href={siteLinks.linkedin} class="pg-btn pg-btn-on-inverse" rel="noopener" target="_blank">LinkedIn ↗</a>
        </div>
      </div>
      <a href={`/cases/${next.slug}`} class="pg-card cs-next">
        <span class="pg-label">Next case</span>
        <span class="pg-h3">{next.title} →</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Reveal cards once as they scroll into view (kit §8).
  const items = document.querySelectorAll<HTMLElement>(".pg-reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }),
      { rootMargin: "0px 0px -8% 0px" },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add("is-in"));
  }
</script>
